# Copy to deploy.env on the server and fill in fresh values. Never commit deploy.env.
APP_DOMAIN=scholarmind.example.com
POSTGRES_DB=scholarmind
POSTGRES_USER=scholarmind
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
ADMIN_EMAILS=your-admin-email@example.com

# Optional. Leave blank to use evidence-only answers for AI requests.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
