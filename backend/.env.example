# PostgreSQL database with the pgvector extension enabled.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/scholarmind
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters
ADMIN_EMAILS=admin@example.com

# Flashcards, quizzes, and mind maps use the local study agent and require Ollama.
# Install Ollama, run `ollama pull qwen3:4b`, then keep Ollama running.
LLM_API_KEY=
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b
# OLLAMA_NUM_CTX=1024
# Local generation timeout in seconds (default 600; maximum 1200).
# OLLAMA_TIMEOUT_SECONDS=600
# Mind-map generation and expansion use a shorter timeout (default 180; maximum 600).
# OLLAMA_MINDMAP_TIMEOUT_SECONDS=180
# To use a remote provider for non-study features, set its key, URL, and model.
EMBEDDING_MODEL=all-MiniLM-L6-v2
