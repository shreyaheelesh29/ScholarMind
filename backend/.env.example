# PostgreSQL database with the pgvector extension enabled.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/scholarmind
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters
ADMIN_EMAILS=admin@example.com

# Optional remote OpenAI-compatible provider. Without a provider, chat returns
# retrieved source passages and generative study tools explain that AI is off.
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Or use local Ollama (no API key required). Start Ollama and pull a model first.
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=qwen3:0.6b
# OLLAMA_NUM_CTX=1024
# Local generation timeout in seconds (default 600; maximum 1200).
# OLLAMA_TIMEOUT_SECONDS=600
# qwen3:1.7b may need more available memory.
EMBEDDING_MODEL=all-MiniLM-L6-v2
