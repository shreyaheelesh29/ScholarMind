# PostgreSQL database with the pgvector extension enabled.
DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/scholarmind
CORS_ORIGINS=http://localhost:5173
AUTH_SECRET=replace-with-a-random-value-of-at-least-32-characters
ADMIN_EMAILS=admin@example.com

# Optional: without these, chat returns source passages rather than an invented answer.
# LLM_API_KEY=your-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=all-MiniLM-L6-v2
